# Nom du projet Docker Compose
COMPOSE_PROJECT_NAME=loganalyzer

# Ports accessibles depuis Ubuntu
WEB_PORT=8000
KIBANA_PORT=5602

# Port sur lequel Flask écoute dans son conteneur
FLASK_PORT=8000

# Adresses utilisées entre les conteneurs
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
# Version commune pour Elasticsearch, Logstash et Kibana
ELASTIC_VERSION=8.19.0

MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_IMAGE_TAG=7.0.45
MONGODB_DATABASE=loganalyzer
REDIS_IMAGE_TAG=7.4.12-alpine
REDIS_HOST=redis
REDIS_PORT=6379