# Nom du projet Docker Compose
COMPOSE_PROJECT_NAME=loganalyzer

# Ports accessibles depuis Ubuntu
WEB_PORT=8000
KIBANA_PORT=5602

# Port sur lequel Flask écoute dans son conteneur
FLASK_PORT=8000

# Adresses utilisées entre les conteneurs
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
# Version commune pour Elasticsearch, Logstash et Kibana
ELASTIC_VERSION=8.19.0

MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_IMAGE_TAG=7.0.45
MONGODB_DATABASE=loganalyzer
REDIS_IMAGE_TAG=7.4.12-alpine
REDIS_HOST=redis
REDIS_PORT=6379

# Taille maximale d’un fichier importé : 100 Mio
MAX_UPLOAD_BYTES=104857600

# Cache des KPI : secondes ; 0 désactive le cache.
STATS_CACHE_TTL_SECONDS=60

# Dashboard Kibana intégré dans Flask.
# URL accessible depuis le navigateur ; adapter si KIBANA_PORT change.
KIBANA_PUBLIC_URL=http://localhost:5602
KIBANA_DASHBOARD_ID=9c0891b8-e4be-4eef-96e1-1c2c89af4c58
KIBANA_EMBED_ENABLED=true

# Clé persistante Kibana : générer au moins 32 caractères dans .env.
KIBANA_SAVED_OBJECTS_KEY=
