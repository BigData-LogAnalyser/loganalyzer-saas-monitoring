{
  "index_patterns": [
    "loganalyzer-logs-*"
  ],
  "priority": 200,
  "version": 2,
  "_meta": {
    "description": "Logs SaaS LogAnalyzer — contrat SCRUM-10 v1.0",
    "ecs_version": "8.17.0"
  },
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.final_pipeline": "loganalyzer-ingested-v1"
    },
    "mappings": {
      "dynamic": "strict",
      "_meta": {
        "schema_version": "1.0",
        "ecs_version": "8.17.0"
      },
      "properties": {
        "@timestamp": {
          "type": "date",
          "format": "strict_date_time"
        },
        "ecs": {
          "properties": {
            "version": {
              "type": "keyword"
            }
          }
        },
        "log": {
          "properties": {
            "level": {
              "type": "keyword"
            },
            "file": {
              "properties": {
                "path": {
                  "type": "keyword"
                }
              }
            }
          }
        },
        "service": {
          "properties": {
            "name": {
              "type": "keyword"
            }
          }
        },
        "message": {
          "type": "match_only_text"
        },
        "event": {
          "properties": {
            "dataset": {
              "type": "keyword"
            },
            "kind": {
              "type": "keyword"
            },
            "id": {
              "type": "keyword"
            },
            "ingested": {
              "type": "date",
              "format": "strict_date_optional_time"
            },
            "duration": {
              "type": "long",
              "coerce": false
            },
            "action": {
              "type": "keyword"
            }
          }
        },
        "loganalyzer": {
          "properties": {
            "upload_id": {
              "type": "keyword"
            },
            "source_line": {
              "type": "long",
              "coerce": false
            },
            "original_filename": {
              "type": "keyword"
            },
            "schema_version": {
              "type": "keyword"
            },
            "search_text": {
              "type": "text",
              "analyzer": "standard"
            },
            "search_values": {
              "type": "wildcard"
            }
          }
        },
        "user": {
          "properties": {
            "id": {
              "type": "keyword"
            }
          }
        },
        "organization": {
          "properties": {
            "id": {
              "type": "keyword"
            }
          }
        },
        "url": {
          "properties": {
            "path": {
              "type": "wildcard"
            }
          }
        },
        "http": {
          "properties": {
            "request": {
              "properties": {
                "method": {
                  "type": "keyword"
                },
                "id": {
                  "type": "keyword"
                }
              }
            },
            "response": {
              "properties": {
                "status_code": {
                  "type": "long",
                  "coerce": false
                }
              }
            }
          }
        },
        "error": {
          "properties": {
            "code": {
              "type": "keyword"
            },
            "message": {
              "type": "match_only_text"
            }
          }
        },
        "saas": {
          "properties": {
            "feature": {
              "type": "keyword"
            },
            "database": {
              "properties": {
                "query_name": {
                  "type": "keyword"
                }
              }
            }
          }
        }
      }
    }
  }
}
